# Copy to .env for local development. Never commit a real key.
GEMINI_API_KEY=replace-with-your-key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
SUPABASE_ROOM_TABLE=rooms
# Configure your TURN provider with short-lived credentials to improve calls across restrictive networks.
# WEBRTC_ICE_SERVERS=[{"urls":"turn:turn.example.com:3478","username":"short-lived-username","credential":"short-lived-password"}]
